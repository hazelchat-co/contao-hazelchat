{
    "name": "hazelchat/contao-hazelchat",
    "description": "Adds the Hazelchat AI chat agent to Contao websites from one pasted installation code. It answers visitors from the pages you approve and passes on their enquiries. Needs a Hazelchat account; the Free plan covers one website.",
    "keywords": ["contao", "chat", "ai", "chat agent", "chatbot", "enquiries", "lead capture", "consent"],
    "type": "contao-bundle",
    "homepage": "https://hazelchat.co/integrations/contao/",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Hazelchat",
            "email": "hello@hazelchat.co",
            "homepage": "https://hazelchat.co",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "hello@hazelchat.co",
        "docs": "https://hazelchat.co/integrations/contao/",
        "issues": "https://github.com/hazelchat-co/contao-hazelchat/issues",
        "source": "https://github.com/hazelchat-co/contao-hazelchat"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3 || ^6.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation-contracts": "^3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0"
    },
    "conflict": {
        "contao/core-bundle": ">=5.6.0 <5.7.1",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Hazelchat\\Contao\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Hazelchat\\Contao\\ContaoManager\\Plugin"
    }
}
